{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronic gadget item for sale in GadgetHub",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" }
      },
      "required": ["name", "brand", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "deliveryMethod": { "type": "string" },
        "deliveryCharge": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "phone", "district", "address", "total", "orderStatus"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review for product",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "userName", "rating", "comment"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email", "displayName"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of gadgets available in the catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders collection"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profiles"
    }
  }
}
